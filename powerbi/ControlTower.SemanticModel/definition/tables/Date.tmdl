table Date
	lineageTag: ee61b3db-d8d0-4f7a-b7d3-9f1ec41f1868

	column date_key
		dataType: dateTime
		lineageTag: ccca9bf1-df6b-46e5-b95c-aaad508e18b0
		summarizeBy: none
		sourceColumn: date_key

	column year
		dataType: double
		lineageTag: 482ecb06-6d41-4dbb-b22d-e7f50907a153
		summarizeBy: none
		sourceColumn: year

	column month
		dataType: double
		lineageTag: 1fad0d25-57f9-4be8-b7cc-3b9134427556
		summarizeBy: none
		sourceColumn: month

	column weekday
		dataType: double
		lineageTag: 3238027a-ecd8-4dca-8ffe-18733b13eb4c
		summarizeBy: none
		sourceColumn: weekday

	column year_month
		dataType: string
		lineageTag: 282d23cc-dd9f-4f4c-986e-6b43d2c54b39
		summarizeBy: none
		sourceColumn: year_month

	partition Date = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_date.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    EmptyToNull = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(EmptyToNull, {{"date_key", type datetime}, {"year", type number}, {"month", type number}, {"weekday", type number}, {"year_month", type text}}, "en-US")
				in
				    Typed


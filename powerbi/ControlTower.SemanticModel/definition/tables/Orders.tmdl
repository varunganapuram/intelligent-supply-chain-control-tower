table Orders
	lineageTag: eb6190e5-840e-49c0-9df9-765265e949da

	/// See docs/kpi_dictionary.md; simulation measures are hypothetical.
	measure 'Total Orders' = COUNTROWS(Orders)
		formatString: #,0
		lineageTag: 57efc83a-b570-4772-b691-8c0d2ebf55f6

	/// See docs/kpi_dictionary.md; simulation measures are hypothetical.
	measure 'Eligible Orders' = COUNT(Orders[is_late])
		formatString: #,0
		lineageTag: e061c120-7efb-4b50-b15d-6a4b8b3179c2

	/// See docs/kpi_dictionary.md; simulation measures are hypothetical.
	measure 'Excluded Orders' = [Total Orders]-[Eligible Orders]
		formatString: #,0
		lineageTag: e2a3694f-770e-4111-b86b-7cce5f064001

	/// See docs/kpi_dictionary.md; simulation measures are hypothetical.
	measure 'Late Orders' = SUM(Orders[is_late])
		formatString: #,0
		lineageTag: c2d2577a-4db5-415e-bc65-f40054acf4f7

	/// See docs/kpi_dictionary.md; simulation measures are hypothetical.
	measure 'Late Delivery %' = DIVIDE([Late Orders],[Eligible Orders])
		formatString: 0.0%
		lineageTag: c6543be0-c684-4a22-b70f-bb6be7a47064

	/// See docs/kpi_dictionary.md; simulation measures are hypothetical.
	measure 'On-Time Delivery %' = IF([Eligible Orders]>0,1-[Late Delivery %])
		formatString: 0.0%
		lineageTag: cc3a18c2-f71d-4e20-8fda-945f486a870f

	/// See docs/kpi_dictionary.md; simulation measures are hypothetical.
	measure 'Average Delivery Days' = AVERAGE(Orders[delivery_days])
		formatString: 0.0
		lineageTag: 7666f999-80b9-479c-bd4d-a445e241d957

	/// See docs/kpi_dictionary.md; simulation measures are hypothetical.
	measure 'P90 Delivery Days' = PERCENTILEX.INC(FILTER(Orders,NOT ISBLANK(Orders[is_late])),Orders[delivery_days],0.9)
		formatString: 0.0
		lineageTag: 0adb7514-470a-4a80-be1e-25067768a71f

	/// See docs/kpi_dictionary.md; simulation measures are hypothetical.
	measure 'Average Delay Days' = AVERAGE(Orders[delay_days])
		formatString: 0.0
		lineageTag: a5ecdcff-dcd8-40c3-b8ce-bf170322d978

	/// See docs/kpi_dictionary.md; simulation measures are hypothetical.
	measure 'Item Value' = SUM(Orders[item_value])
		formatString: R$ #,0.00
		lineageTag: 9f599c9a-60a3-4fa8-82d1-79b3282d584b

	/// See docs/kpi_dictionary.md; simulation measures are hypothetical.
	measure 'Reviewed Orders' = COUNT(Orders[review_score])
		formatString: #,0
		lineageTag: 86eb34bd-0675-4f46-b330-c2f1f49c26e1

	/// See docs/kpi_dictionary.md; simulation measures are hypothetical.
	measure 'Low Review Orders' = CALCULATE(COUNTROWS(Orders),Orders[review_score] IN {1,2})
		formatString: #,0
		lineageTag: 0a9f7287-6bc7-48a9-8cef-e826aa0daf4b

	/// See docs/kpi_dictionary.md; simulation measures are hypothetical.
	measure 'Dissatisfaction %' = DIVIDE([Low Review Orders],[Reviewed Orders])
		formatString: 0.0%
		lineageTag: f14c4774-4a4c-4014-8d8b-e189e397e1c8

	/// See docs/kpi_dictionary.md; simulation measures are hypothetical.
	measure 'Single-Seller Eligible' = CALCULATE([Eligible Orders],Orders[seller_count]=1)
		formatString: #,0
		lineageTag: cba65c7d-ff9d-4484-9187-7bf8b6e8f17d

	/// See docs/kpi_dictionary.md; simulation measures are hypothetical.
	measure 'Single-Seller Late %' = DIVIDE(CALCULATE([Late Orders],Orders[seller_count]=1),[Single-Seller Eligible])
		formatString: 0.0%
		lineageTag: c55dd065-fcb0-4487-818d-9c6e1881af57

	/// See docs/kpi_dictionary.md; simulation measures are hypothetical.
	measure 'Scored Orders' = COUNTROWS(Risk)
		formatString: #,0
		lineageTag: 11593d03-68e7-4dc0-a979-6eb2dfcb9698

	/// See docs/kpi_dictionary.md; simulation measures are hypothetical.
	measure 'High Risk Orders' = CALCULATE(COUNTROWS(Risk),Risk[risk_category]="High")
		formatString: #,0
		lineageTag: 07b2f569-4811-4458-821b-b7d95b768d36

	/// See docs/kpi_dictionary.md; simulation measures are hypothetical.
	measure 'Mean Risk' = AVERAGE(Risk[risk_probability])
		formatString: 0.0%
		lineageTag: 7d698ae0-330e-4669-af48-1e9073db5f62

	/// See docs/kpi_dictionary.md; simulation measures are hypothetical.
	measure 'Selected Cases' = IF(HASONEVALUE(Scenario[scenario_id]),CALCULATE(COUNTROWS(Decisions),Decisions[selected_for_intervention]=TRUE()))
		formatString: #,0
		lineageTag: 3d4feeaf-e7e6-4246-9c52-dbacc0888d64

	/// See docs/kpi_dictionary.md; simulation measures are hypothetical.
	measure 'Assumed Investigation Cost' = IF(HASONEVALUE(Scenario[scenario_id]),CALCULATE(SUM(Decisions[intervention_cost]),Decisions[selected_for_intervention]=TRUE()))
		formatString: R$ #,0.00
		lineageTag: 62da7182-67b1-45fe-90fd-35b9b215eedc

	/// See docs/kpi_dictionary.md; simulation measures are hypothetical.
	measure 'Simulated Net Benefit' = IF(HASONEVALUE(Scenario[scenario_id]),CALCULATE(SUM(Decisions[expected_net_benefit]),Decisions[selected_for_intervention]=TRUE()))
		formatString: R$ #,0.00
		lineageTag: a39b93b5-9419-4029-a79e-a5ca3df7df0c

	/// See docs/kpi_dictionary.md; simulation measures are hypothetical.
	measure 'Model Test AP' = MAX(ModelEvaluation[average_precision])
		formatString: 0.000
		lineageTag: 28dd8def-d2aa-4dec-b325-00f74c138a17

	/// See docs/kpi_dictionary.md; simulation measures are hypothetical.
	measure 'Model Precision at 50 per Day' = MAX(ModelEvaluation[precision_at_50_daily])
		formatString: 0.0%
		lineageTag: ad98ac99-a862-4454-acf1-d4d31753cb13

	/// See docs/kpi_dictionary.md; simulation measures are hypothetical.
	measure 'Scenario Assumed Effectiveness' = SELECTEDVALUE(Scenario[effectiveness])
		formatString: 0%
		lineageTag: 7051951b-788f-411e-a746-e4500db19d46


        "partitions": [
          {
            "name": "Orders",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"fct_order.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    EmptyToNull = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(EmptyToNull, {{\"order_id\", type text}, {\"customer_id\", type text}, {\"order_status\", type text}, {\"order_purchase_timestamp\", type datetime}, {\"order_approved_at\", type datetime}, {\"order_delivered_carrier_date\", type datetime}, {\"order_delivered_customer_date\", type datetime}, {\"order_estimated_delivery_date\", type datetime}, {\"purchase_date\", type datetime}, {\"customer_state\", type text}, {\"item_count\", type number}, {\"seller_count\", type number}, {\"item_value\", type number}, {\"freight_value\", type number}, {\"weight_g\", type number}, {\"volume_cm3\", type number}, {\"distance_km\", type number}, {\"first_shipping_limit\", type datetime}, {\"primary_seller_id\", type text}, {\"primary_category\", type text}, {\"primary_seller_state\", type text}, {\"payment_value\", type number}, {\"payment_count\", type number}, {\"review_score\", type number}, {\"eligible_delivery\", type logical}, {\"is_late\", type number}, {\"delivery_days\", type number}, {\"delay_days\", type number}, {\"promised_days\", type number}, {\"handoff_days\", type number}, {\"transit_days\", type number}, {\"handoff_after_item_deadline\", type number}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Orders",
            "expression": "COUNTROWS(Orders)",
            "formatString": "#,0",
            "description": "See docs/kpi_dictionary.md; simulation measures are hypothetical."
          },
          {
            "name": "Eligible Orders",
            "expression": "COUNT(Orders[is_late])",
            "formatString": "#,0",
            "description": "See docs/kpi_dictionary.md; simulation measures are hypothetical."
          },
          {
            "name": "Excluded Orders",
            "expression": "[Total Orders]-[Eligible Orders]",
            "formatString": "#,0",
            "description": "See docs/kpi_dictionary.md; simulation measures are hypothetical."
          },
          {
            "name": "Late Orders",
            "expression": "SUM(Orders[is_late])",
            "formatString": "#,0",
            "description": "See docs/kpi_dictionary.md; simulation measures are hypothetical."
          },
          {
            "name": "Late Delivery %",
            "expression": "DIVIDE([Late Orders],[Eligible Orders])",
            "formatString": "0.0%",
            "description": "See docs/kpi_dictionary.md; simulation measures are hypothetical."
          },
          {
            "name": "On-Time Delivery %",
            "expression": "IF([Eligible Orders]>0,1-[Late Delivery %])",
            "formatString": "0.0%",
            "description": "See docs/kpi_dictionary.md; simulation measures are hypothetical."
          },
          {
            "name": "Average Delivery Days",
            "expression": "AVERAGE(Orders[delivery_days])",
            "formatString": "0.0",
            "description": "See docs/kpi_dictionary.md; simulation measures are hypothetical."
          },
          {
            "name": "P90 Delivery Days",
            "expression": "PERCENTILEX.INC(FILTER(Orders,NOT ISBLANK(Orders[is_late])),Orders[delivery_days],0.9)",
            "formatString": "0.0",
            "description": "See docs/kpi_dictionary.md; simulation measures are hypothetical."
          },
          {
            "name": "Average Delay Days",
            "expression": "AVERAGE(Orders[delay_days])",
            "formatString": "0.0",
            "description": "See docs/kpi_dictionary.md; simulation measures are hypothetical."
          },
          {
            "name": "Item Value",
            "expression": "SUM(Orders[item_value])",
            "formatString": "R$ #,0.00",
            "description": "See docs/kpi_dictionary.md; simulation measures are hypothetical."
          },
          {
            "name": "Reviewed Orders",
            "expression": "COUNT(Orders[review_score])",
            "formatString": "#,0",
            "description": "See docs/kpi_dictionary.md; simulation measures are hypothetical."
          },
          {
            "name": "Low Review Orders",
            "expression": "CALCULATE(COUNTROWS(Orders),Orders[review_score] IN {1,2})",
            "formatString": "#,0",
            "description": "See docs/kpi_dictionary.md; simulation measures are hypothetical."
          },
          {
            "name": "Dissatisfaction %",
            "expression": "DIVIDE([Low Review Orders],[Reviewed Orders])",
            "formatString": "0.0%",
            "description": "See docs/kpi_dictionary.md; simulation measures are hypothetical."
          },
          {
            "name": "Single-Seller Eligible",
            "expression": "CALCULATE([Eligible Orders],Orders[seller_count]=1)",
            "formatString": "#,0",
            "description": "See docs/kpi_dictionary.md; simulation measures are hypothetical."
          },
          {
            "name": "Single-Seller Late %",
            "expression": "DIVIDE(CALCULATE([Late Orders],Orders[seller_count]=1),[Single-Seller Eligible])",
            "formatString": "0.0%",
            "description": "See docs/kpi_dictionary.md; simulation measures are hypothetical."
          },
          {
            "name": "Scored Orders",
            "expression": "COUNTROWS(Risk)",
            "formatString": "#,0",
            "description": "See docs/kpi_dictionary.md; simulation measures are hypothetical."
          },
          {
            "name": "High Risk Orders",
            "expression": "CALCULATE(COUNTROWS(Risk),Risk[risk_category]=\"High\")",
            "formatString": "#,0",
            "description": "See docs/kpi_dictionary.md; simulation measures are hypothetical."
          },
          {
            "name": "Mean Risk",
            "expression": "AVERAGE(Risk[risk_probability])",
            "formatString": "0.0%",
            "description": "See docs/kpi_dictionary.md; simulation measures are hypothetical."
          },
          {
            "name": "Selected Cases",
            "expression": "IF(HASONEVALUE(Scenario[scenario_id]),CALCULATE(COUNTROWS(Decisions),Decisions[selected_for_intervention]=TRUE()))",
            "formatString": "#,0",
            "description": "See docs/kpi_dictionary.md; simulation measures are hypothetical."
          },
          {
            "name": "Assumed Investigation Cost",
            "expression": "IF(HASONEVALUE(Scenario[scenario_id]),CALCULATE(SUM(Decisions[intervention_cost]),Decisions[selected_for_intervention]=TRUE()))",
            "formatString": "R$ #,0.00",
            "description": "See docs/kpi_dictionary.md; simulation measures are hypothetical."
          },
          {
            "name": "Simulated Net Benefit",
            "expression": "IF(HASONEVALUE(Scenario[scenario_id]),CALCULATE(SUM(Decisions[expected_net_benefit]),Decisions[selected_for_intervention]=TRUE()))",
            "formatString": "R$ #,0.00",
            "description": "See docs/kpi_dictionary.md; simulation measures are hypothetical."
          },
          {
            "name": "Model Test AP",
            "expression": "MAX(ModelEvaluation[average_precision])",
            "formatString": "0.000",
            "description": "See docs/kpi_dictionary.md; simulation measures are hypothetical."
          },
          {
            "name": "Model Precision at 50 per Day",
            "expression": "MAX(ModelEvaluation[precision_at_50_daily])",
            "formatString": "0.0%",
            "description": "See docs/kpi_dictionary.md; simulation measures are hypothetical."
          },
          {
            "name": "Scenario Assumed Effectiveness",
            "expression": "SELECTEDVALUE(Scenario[effectiveness])",
            "formatString": "0%",
            "description": "See docs/kpi_dictionary.md; simulation measures are hypothetical."
          }
        ]
      },
